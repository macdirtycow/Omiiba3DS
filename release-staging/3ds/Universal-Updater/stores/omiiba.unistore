            "Install latest Omiiba3DS boot.firm": [
                {
                    "type": "downloadFile",
                    "file": "https://github.com/macdirtycow/Omiiba3DS/releases/latest/download/Omiiba3DS-v1.4.7.zip",
                    "message": "Downloading latest Omiiba3DS release zip...",
                    "output": "sdmc:/omiiba/update/Omiiba3DS-latest.zip"
                },
                {
                    "type": "extractFile",
                    "file": "sdmc:/omiiba/update/Omiiba3DS-latest.zip",
                    "input": "boot.firm",
                    "message": "Installing boot.firm to SD root...",
                    "output": "sdmc:/boot.firm"
                },
                {
                    "type": "deleteFile",
                    "file": "sdmc:/omiiba/update/Omiiba3DS-latest.zip",
                    "message": "Cleaning temporary update zip..."
                }
            ],
            "Download full release zip only": [
